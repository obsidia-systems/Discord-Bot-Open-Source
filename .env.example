# Copia a .env en la raíz del repo. El backend lo carga con
# `node --env-file-if-exists=../.env` (sin la dependencia `dotenv`).
# En Docker el env llega por docker-compose (`env_file:` + `environment:`).

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret (NO el token del bot). Resetéalo en el portal si lo mezclaste.
DISCORD_CLIENT_SECRET=
# Solo para sync inicial de slash por guild (legacy). Ya no es fallback de la API.
DISCORD_GUILD_ID=
# Shards internos de discord.js: auto (recomendado) o un entero.
# SHARD_COUNT=auto

# Rol del proceso (mismo binario). Default all = API + gateway + crons (Compose actual).
# No lances dos `all` ni gateway+worker con el mismo DISCORD_TOKEN.
# api     = solo HTTP (N réplicas cuando el gateway esté en otro proceso)
# gateway = Discord websocket (1)
# worker  = crons + login para enviar (1; advisory lock Postgres)
# ADOBO_ROLE=all

# Panel / API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Nivel de pino: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
# Logs coloridos en local (no usar en Compose; JSON es el default):
# LOG_PRETTY=1
# URL pública del panel (redirect OAuth). En Compose de desarrollo: 4321 (Astro).
# En Compose de producción: la URL que ve el navegador (nginx, p. ej. :3000).
PUBLIC_APP_URL=http://localhost:4321
# Allowlist CORS (obligatorio en producción). Varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:4321
# Firma de cookies de sesión y cifrado del access token OAuth (≥16 chars).
SESSION_SECRET=cambiar-esto-en-local-min-16
# CSP del panel: por defecto obligatoria. Ponla en modo report-only (log de
# violaciones sin bloquear) mientras validas el dashboard tras un cambio grande.
# CSP_REPORT_ONLY=1

# Postgres (Compose de desarrollo inyecta postgresql://adobos@postgres:5432/adobos)
# En el host sin Docker:
DATABASE_URL=postgresql://adobos:adobos@127.0.0.1:5432/adobos

# Redis (opcional). Sin esto: caché en memoria por proceso + rate-limit por
# proceso — vale para el rol `all` y dev. Con réplicas del rol `api` o cola
# (BullMQ) es obligatorio. Compose lo inyecta como redis://redis:6379.
# REDIS_URL=redis://127.0.0.1:6379

# Tamaño del pool de Postgres. Por defecto según ADOBO_ROLE: api=8, gateway/worker=6, all=12.
# Con N réplicas del rol `api`, ojo con max_connections de Postgres (N × este valor).
# DB_POOL_MAX=8
# Compose producción (obligatorio). Desarrollo usa usuario/clave `adobos`.
# POSTGRES_PASSWORD=
# Puerto público del panel en producción (nginx).
# FRONTEND_PORT=3000
# Uploads (independiente de la DB)
DATA_DIR=./data
# El SSR de Astro (dev) y el proxy Vite usan esto. Compose inyecta http://backend:3000.
# INTERNAL_API_URL=http://127.0.0.1:3000

# Zona horaria de crons globales (auto-delete horario, etc.)
# Los mensajes programados guardan su propia zona por mensaje desde el panel.
# Prioridad: SCHEDULER_TZ → AUTO_DELETE_TZ → TZ → zona del proceso
# SCHEDULER_TZ=America/Mexico_City

# Stripe Billing (opcional en local: checkout/portal responden 503 si faltan claves).
# Test mode está bien. El webhook debe apuntar a POST /api/billing/webhook
# (CLI: stripe listen --forward-to localhost:3000/api/billing/webhook).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (empiezan por price_, NO por prod_): Product catalog → producto → precio.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# Stream Alerts (opcional). Sin clave, esa plataforma no se comprueba.
# Twitch Helix — app de https://dev.twitch.tv/console/apps (Client Credentials).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube Data API v3. Search live ~100 unidades; el bot espera 5 min por canal.
# YOUTUBE_API_KEY=
# Kick usa la API pública v2; no necesita clave. TikTok queda fuera (D).
