# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret (NO el token del bot). Resetéalo en el portal si lo mezclaste.
DISCORD_CLIENT_SECRET=
# Solo para sync inicial de slash por guild (legacy). Ya no es fallback de la API.
DISCORD_GUILD_ID=
# Shards internos de discord.js: auto (recomendado) o un entero.
# SHARD_COUNT=auto

# Panel / API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:4321
# Allowlist CORS (obligatorio en producción). Varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:4321
# Firma de cookies de sesión y cifrado del access token OAuth (≥16 chars).
SESSION_SECRET=cambiar-esto-en-local-min-16

# Postgres (docker compose inyecta postgresql://adobos@postgres:5432/adobos)
# En el host sin Docker:
DATABASE_URL=postgresql://adobos:adobos@127.0.0.1:5432/adobos
# Uploads (independiente de la DB)
DATA_DIR=./data

# Zona horaria de crons globales (auto-delete horario, etc.)
# Los mensajes programados guardan su propia zona por mensaje desde el panel.
# Prioridad: SCHEDULER_TZ → AUTO_DELETE_TZ → TZ → zona del proceso
# SCHEDULER_TZ=America/Mexico_City
