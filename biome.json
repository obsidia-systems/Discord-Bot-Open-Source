{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/backend/public/**",
      "!**/backend/drizzle/**",
      "!**/*.tsbuildinfo",
      "!**/coverage/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "backend/src/modules/*/domain/**/*.ts",
        "backend/src/modules/*/service.ts",
        "!backend/src/modules/action-logs/service.ts",
        "!backend/src/modules/canvas-events/service.ts",
        "!backend/src/modules/roles-builder/service.ts",
        "!backend/src/modules/welcome/service.ts",
        "!backend/src/modules/bot-profile/service.ts",
        "!backend/src/modules/moderation/service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "discord.js": "La capa de dominio no habla con el gateway; mueve esto a events/, commands/, handlers/ o api/.",
                  "express": "La capa de dominio no conoce HTTP; el router (api/routes.ts) adapta request → dominio."
                }
              }
            }
          }
        }
      }
    }
  ]
}
