{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/backend/public/**",
      "!**/backend/drizzle/**",
      "!**/*.tsbuildinfo",
      "!**/coverage/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "backend/src/modules/*/domain/**/*.ts",
        "!backend/src/modules/*/domain/**/*.test.ts",
        "!backend/src/modules/action-logs/domain/action-logs.ts",
        "!backend/src/modules/canvas-events/domain/canvas-events.ts",
        "!backend/src/modules/roles-builder/domain/roles-builder.ts",
        "!backend/src/modules/welcome/domain/welcome.ts",
        "!backend/src/modules/bot-profile/domain/bot-profile.ts",
        "!backend/src/modules/moderation/domain/moderation.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "discord.js": "La capa de dominio no habla con el gateway; mueve esto a gateway/, commands/, handlers/ o http/.",
                  "express": "La capa de dominio no conoce HTTP; el router (http/routes.ts) adapta request → dominio."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["backend/src/modules/*/gateway.ts", "backend/src/modules/*/gateway/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "express": "gateway/ maneja eventos de Discord, no HTTP."
                }
              }
            }
          }
        }
      }
    }
  ]
}
