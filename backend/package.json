{
  "name": "@adobos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": {
      "adobos-src": "./src/core/*",
      "default": "./dist/core/*"
    },
    "#modules/*": {
      "adobos-src": "./src/modules/*",
      "default": "./dist/modules/*"
    },
    "#db/*": {
      "adobos-src": "./src/db/*",
      "default": "./dist/db/*"
    },
    "#lib/*": {
      "adobos-src": "./src/lib/*",
      "default": "./dist/lib/*"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--conditions=adobos-src\" tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=\"--conditions=adobos-src\" tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@adobos/shared": "workspace:*",
    "@napi-rs/canvas": "^1.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.24.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.30.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
