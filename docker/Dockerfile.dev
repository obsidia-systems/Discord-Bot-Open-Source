# Imagen de desarrollo (hot reload). glibc: el DNS interno de Compose
# (`postgres`, `backend`) falla a menudo en Alpine/musl (EAI_AGAIN).
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ fontconfig \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
