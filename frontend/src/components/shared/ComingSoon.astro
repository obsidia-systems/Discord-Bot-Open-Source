---
import DashboardLayout from "../../layouts/DashboardLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "This module is set up in the menu. The implementation arrives in a later iteration.",
} = Astro.props;
---

<DashboardLayout title={title} description={description}>
  <section
    class="relative overflow-hidden rounded-2xl border border-dashed border-primary/25 bg-card/60 p-8 backdrop-blur-sm"
  >
    <div
      class="pointer-events-none absolute -right-10 -top-10 size-40 rounded-full bg-primary/15 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <p class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-primary">
      Under construction
    </p>
    <p class="mt-2 max-w-xl text-sm text-muted-foreground">
      The dashboard architecture already accounts for this module. When we
      implement it, it will live here without breaking the core or the plugins.
    </p>
  </section>
</DashboardLayout>
