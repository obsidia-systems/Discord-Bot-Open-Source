---
import DashboardLayout from "../../layouts/DashboardLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Este módulo está preparado en el menú. La implementación llega en una iteración posterior.",
} = Astro.props;
---

<DashboardLayout title={title} description={description}>
  <section class="rounded-lg border border-dashed border-border bg-card/50 p-8">
    <p class="text-sm font-medium text-foreground">En construcción</p>
    <p class="mt-2 max-w-xl text-sm text-muted-foreground">
      La arquitectura del dashboard ya contempla este módulo. Cuando lo
      implementemos, vivirá aquí sin romper el núcleo ni los plugins.
    </p>
  </section>
</DashboardLayout>
