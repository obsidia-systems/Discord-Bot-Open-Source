---
import BaseLayout from "./BaseLayout.astro";
import PanelSidebar from "../components/panel/PanelSidebar.astro";
import { PanelGuildSwitcher } from "../components/panel/PanelGuildSwitcher";
import { PanelUserMenu } from "../components/panel/PanelUserMenu";
import { PanelMobileMenu } from "../components/panel/PanelMobileMenu";
import { Button } from "../components/ui/button";

interface Props {
  title: string;
  description?: string;
  compactContent?: boolean;
}

const { title, description, compactContent } = Astro.props;
const panel = Astro.locals.panel;
if (!panel) {
  return Astro.redirect("/");
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const { me, selectedGuild, tier } = panel;
const emptyGuilds = me.guilds.length === 0;
const missingBot = Boolean(selectedGuild && !selectedGuild.botPresent);
---

<BaseLayout title={`${title} — tobot.`} description={description}>
  <div class="tobot-shell flex h-dvh overflow-hidden bg-background">
    <div class="flex h-dvh shrink-0 max-lg:w-0 max-lg:overflow-visible">
      <PanelSidebar currentPath={currentPath} tier={tier} />
    </div>

    <div class="relative flex min-h-0 min-w-0 flex-1 flex-col">
      <header
        class="landing-nav-filled absolute inset-x-0 top-0 z-50 flex h-[var(--topbar-h)] items-center gap-3 px-[var(--dash-pad)] transition-[background-color,border-color,backdrop-filter] duration-[var(--dur-slow)] ease-[cubic-bezier(0.32,0.72,0,1)]"
      >
        <PanelMobileMenu client:load transition:persist="panel-mobile-menu" />
        <h1 class="sr-only">{title}</h1>
        <div class="min-w-0 flex-1">
          <PanelGuildSwitcher
            client:load
            transition:persist="panel-guild"
            guilds={me.guilds}
            selected={selectedGuild}
          />
        </div>
        <PanelUserMenu
          client:load
          transition:persist="panel-user"
          user={me.user}
          tier={tier}
        />
      </header>

      <div class="tobot-scroll relative min-h-0 flex-1 overflow-y-auto pt-[var(--topbar-h)]">
        {
          missingBot && selectedGuild ? (
            <div class="flex flex-wrap items-center justify-between gap-2 bg-background px-[var(--dash-pad)] py-2 text-sm">
              <p class="text-muted-foreground">
                tobot isn't in this server. Add it to use the dashboard.
              </p>
              <a
                href={`/auth/invite?guildId=${encodeURIComponent(selectedGuild.id)}`}
                data-astro-reload
                class="font-mono text-xs font-bold uppercase tracking-[0.1em] text-primary hover:underline"
              >
                Add to the server
              </a>
            </div>
          ) : null
        }

        {
          emptyGuilds ? (
            <div class="flex h-full flex-col items-center justify-center gap-3 bg-background px-6 text-center">
              <h2 class="font-display text-lg font-semibold">No servers</h2>
              <p class="max-w-md text-sm text-muted-foreground">
                Add tobot to a server where you can Manage Server. Discord will
                ask for the permissions; then come back and sign in with your
                account.
              </p>
              <Button href="/auth/invite" reload>Add to a server</Button>
            </div>
          ) : (
            <main class:list={["px-[var(--dash-pad)] py-[var(--dash-pad)]", !compactContent && "min-h-full"]}>
              <slot />
            </main>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
