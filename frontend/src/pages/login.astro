---
import BaseLayout from "../layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");
const messages: Record<string, string> = {
  oauth_denied: "You canceled the sign-in or Discord rejected it.",
  oauth_state: "The login session expired. Try again.",
  oauth_token: "Couldn't exchange the code with Discord.",
  oauth_client:
    "Discord rejected the OAuth client. DISCORD_CLIENT_SECRET must be the OAuth2 Client Secret (portal → OAuth2), not the bot token.",
  oauth_user: "Couldn't read your Discord user.",
  oauth_callback: "The OAuth callback failed.",
  oauth_config:
    "Missing OAuth configuration (CLIENT_ID, CLIENT_SECRET, PUBLIC_APP_URL, SESSION_SECRET). The secret can't be the bot token.",
};
const errorText = error ? (messages[error] ?? "Couldn't sign in.") : null;
---

<BaseLayout title="Sign in — Adobos Bot" description="Access the dashboard with Discord.">
  <main class="flex min-h-dvh items-center justify-center bg-background px-4">
    <section
      class="w-full max-w-md rounded-2xl border border-border/70 bg-card/80 p-8 shadow-sm backdrop-blur-md"
    >
      <p
        class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-primary"
      >
        Adobos Bot
      </p>
      <h1 class="mt-2 font-display text-2xl font-semibold tracking-tight">
        Sign in to the dashboard
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        First add the bot to your server (Discord asks for permissions). Then
        sign in to the dashboard with your account to configure it.
      </p>
      {
        errorText && (
          <p class="mt-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
            {errorText}
          </p>
        )
      }
      <a
        href="/auth/invite"
        data-astro-reload
        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
      >
        Add to a server
      </a>
      <a
        href="/auth/discord"
        data-astro-reload
        class="mt-3 inline-flex w-full items-center justify-center rounded-full border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground transition hover:bg-accent"
      >
        Already in my server — sign in
      </a>
    </section>
  </main>
</BaseLayout>
