---
import BaseLayout from "../layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");
const messages: Record<string, string> = {
  oauth_denied: "Cancelaste el acceso o Discord lo rechazó.",
  oauth_state: "La sesión de login expiró. Prueba otra vez.",
  oauth_token: "No se pudo intercambiar el código con Discord.",
  oauth_client:
    "Discord rechazó el cliente OAuth. DISCORD_CLIENT_SECRET debe ser el Client Secret de OAuth2 (portal → OAuth2), no el token del bot.",
  oauth_user: "No se pudo leer tu usuario de Discord.",
  oauth_callback: "Falló el callback de OAuth.",
  oauth_config:
    "Falta configuración OAuth (CLIENT_ID, CLIENT_SECRET, PUBLIC_APP_URL, SESSION_SECRET). El secret no puede ser el token del bot.",
};
const errorText = error ? (messages[error] ?? "No se pudo iniciar sesión.") : null;
---

<BaseLayout title="Entrar — Adobos Bot" description="Accede al panel con Discord.">
  <main class="flex min-h-dvh items-center justify-center bg-background px-4">
    <section
      class="w-full max-w-md rounded-2xl border border-border/70 bg-card/80 p-8 shadow-sm backdrop-blur-md"
    >
      <p
        class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-primary"
      >
        Adobos Bot
      </p>
      <h1 class="mt-2 font-display text-2xl font-semibold tracking-tight">
        Entra al panel
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Usamos Discord (identify + guilds) para comprobar que puedes gestionar
        el servidor. No hay cuentas aparte.
      </p>
      {
        errorText && (
          <p class="mt-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
            {errorText}
          </p>
        )
      }
      <a
        href="/auth/discord"
        data-astro-reload
        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
      >
        Continuar con Discord
      </a>
    </section>
  </main>
</BaseLayout>
