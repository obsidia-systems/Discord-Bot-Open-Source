---
import type { HealthResponse } from "@adobos/shared";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { DashboardHome } from "../../features/dashboard";

const API_ORIGIN = import.meta.env.INTERNAL_API_URL ?? "http://127.0.0.1:3000";

let initialHealth: HealthResponse | null = null;
try {
  const response = await fetch(`${API_ORIGIN}/api/health`, {
    headers: { Accept: "application/json" },
  });
  if (response.ok) {
    initialHealth = (await response.json()) as HealthResponse;
  }
} catch {
  initialHealth = null;
}
---

<DashboardLayout
  title="Dashboard"
  description="Centro de control self-hosted — estética Adobos / Ado."
>
  <DashboardHome client:load initialHealth={initialHealth} />
</DashboardLayout>
