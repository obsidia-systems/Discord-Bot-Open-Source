{
	auto_https disable_redirects
}

https://dash.tobot.test {
	tls internal
	header {
		# astro dev inlines the island runtime. Hashed CSP is unavailable in dev.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	handle /metrics {
		respond "not found" 404
	}
	handle /interactions* {
		respond "not found" 404
	}
	handle /api/* {
		reverse_proxy control-plane:8080
	}
	handle /auth/login {
		reverse_proxy dash:4321
	}
	handle /auth/* {
		reverse_proxy control-plane:8080
	}
	handle /install/discord/* {
		reverse_proxy control-plane:8080
	}
	handle /health/* {
		reverse_proxy control-plane:8080
	}
	reverse_proxy dash:4321
}

https://www.tobot.test {
	tls internal
	reverse_proxy www:4321
}

https://docs.tobot.test {
	tls internal
	reverse_proxy docs:4321
}

https://admin.tobot.test {
	tls internal
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	handle /metrics {
		respond "not found" 404
	}
	reverse_proxy admin:4321
}
