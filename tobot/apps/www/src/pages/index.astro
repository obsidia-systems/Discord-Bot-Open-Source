---
import Document from "../layouts/Document.astro";
---

<Document title="Tobot">
  <main
    class="mx-auto flex min-h-dvh w-full max-w-2xl flex-col justify-center px-6"
  >
    <h1 class="text-3xl font-semibold tracking-tight">Tobot</h1>
    <p class="mt-3 text-lg leading-relaxed text-zinc-700">
      Un bot, todos tus servidores.
    </p>
    <a
      class="mt-8 w-fit underline decoration-zinc-400 underline-offset-4 hover:decoration-zinc-950"
      href="https://dash.tobot.test/auth/login">Iniciar sesión</a
    >
  </main>
</Document>
