---
import ShellLayout from "../layouts/ShellLayout.astro";
import { BillingSetup } from "../components/BillingSetup";
---

<ShellLayout title="Plans · Admin">
  <main id="content" class="mx-auto w-full max-w-4xl px-6 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">Plans</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-zinc-700">The free plan has no Stripe price. A paid plan keeps Stripe on the left and features on the right. Changing a paid plan publishes a new version.</p>
    <BillingSetup client:load />
  </main>
</ShellLayout>
