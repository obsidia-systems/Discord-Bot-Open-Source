---
import ShellLayout from "../layouts/ShellLayout.astro";
import { BillingSetup } from "../components/BillingSetup";
---

<ShellLayout title="Billing setup · Admin">
  <main id="content" class="mx-auto w-full max-w-4xl px-6 py-12">
    <a href="/" class="text-sm text-zinc-700 underline">Admin overview</a>
    <h1 class="mt-6 text-2xl font-semibold tracking-tight">Billing setup</h1>
    <p class="mt-3 leading-relaxed text-zinc-700">Create a Stripe test price, choose it, then publish it as an offer. Dash can sell that offer only after Billing accepts it.</p>
    <BillingSetup client:load />
  </main>
</ShellLayout>
