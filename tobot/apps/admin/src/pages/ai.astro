---
import ShellLayout from "../layouts/ShellLayout.astro";
import { AiDesk } from "../components/AiDesk";
---

<ShellLayout title="AI · Admin">
  <main id="content" class="mx-auto w-full max-w-5xl px-6 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">AI</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-zinc-700">Assign a saved provider and model to Ask. The provider and its key are registered here. One credit is one micro-USD of the token price you enter, rounded up. A provider list does not include a price.</p>
    <AiDesk client:load />
  </main>
</ShellLayout>
