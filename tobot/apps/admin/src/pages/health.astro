---
import { StatusBoard } from "../components/StatusBoard";
import ShellLayout from "../layouts/ShellLayout.astro";
import { collectStatus } from "../lib/status";

const initial = await collectStatus();
---

<ShellLayout title="Health · Admin">
  <main id="content" class="mx-auto w-full max-w-4xl px-6 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">Health</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-zinc-700">
      Control Plane, Delivery, and Discord Edge. Up, Not ready, and Down are written out next to each probe.
    </p>
    <StatusBoard client:load initial={initial} />
  </main>
</ShellLayout>
