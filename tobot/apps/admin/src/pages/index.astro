---
import { OperatorDesk } from "../components/OperatorDesk";
import ShellLayout from "../layouts/ShellLayout.astro";
import { collectStatus } from "../lib/status";

const initial = await collectStatus();
---

<ShellLayout title="Overview · Admin">
  <main id="content" class="mx-auto w-full max-w-4xl px-6 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">Overview</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-zinc-700">
      This console sells plans and operates AI credits. Server setup lives on the dashboard.
    </p>
    <OperatorDesk client:load initial={initial} />
  </main>
</ShellLayout>
