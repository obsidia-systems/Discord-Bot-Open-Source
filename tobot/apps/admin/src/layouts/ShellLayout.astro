---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const items = [
  { href: "/", label: "Overview" },
  { href: "/health", label: "Health" },
  { href: "/billing", label: "Plans" },
  { href: "/ai", label: "AI" },
];

function current(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-white font-sans text-zinc-950 antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:bg-white focus:px-3 focus:py-2"
      href="#content">Skip to content</a
    >
    <header class="border-b border-zinc-200">
      <div class="mx-auto flex w-full max-w-4xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <a href="/" class="font-semibold tracking-tight">Tobot Admin</a>
        <nav aria-label="Operator" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {items.map((item) => (
            <a
              href={item.href}
              aria-current={current(item.href) ? "page" : undefined}
              class:list={["underline-offset-4", current(item.href) ? "font-semibold underline" : "text-zinc-700"]}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>
