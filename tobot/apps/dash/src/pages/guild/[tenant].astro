---
import { GuildHome } from "../../components/GuildHome";
import GuildFrame from "../../components/GuildFrame.astro";
import ShellLayout from "../../layouts/ShellLayout.astro";
import { SESSION_COOKIE } from "../../lib/session";
import { isTenantId } from "../../lib/shell-state";

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session?.value) return Astro.redirect("/auth/login");

const tenant = Astro.params.tenant ?? "";
const knownTenant = isTenantId(tenant);
---

<ShellLayout title="Server">
  <GuildFrame tenant={tenant} section="overview">
    {
      knownTenant ? (
        <GuildHome client:load tenantId={tenant} />
      ) : (
        <>
          <h1 class="text-2xl font-semibold tracking-tight">No access</h1>
          <p class="mt-3 leading-relaxed text-zinc-700" role="alert">
            You do not have access to this server.
          </p>
          <a
            class="mt-6 inline-block underline decoration-zinc-400 underline-offset-4 hover:decoration-zinc-950"
            href="/">Back to servers</a
          >
        </>
      )
    }
  </GuildFrame>
</ShellLayout>
