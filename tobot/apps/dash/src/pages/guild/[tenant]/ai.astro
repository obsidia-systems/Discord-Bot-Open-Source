---
import AppHeader from "../../../components/AppHeader.astro";
import { AiUsageView } from "../../../components/AiUsageView";
import ShellLayout from "../../../layouts/ShellLayout.astro";
import { SESSION_COOKIE } from "../../../lib/session";
import { isTenantId } from "../../../lib/shell-state";
const session=Astro.cookies.get(SESSION_COOKIE);
if (!session?.value) return Astro.redirect("/auth/login");
const tenant=Astro.params.tenant??"";
---
<ShellLayout title="AI credits">
  <AppHeader />
  <main id="content" class="mx-auto w-full max-w-2xl px-6 pb-16">
    <h1 class="font-serif text-3xl text-zinc-950">AI credits</h1>
    <p class="mt-2 text-sm text-zinc-700">Your text operations and credit reservations. A reservation in review is not a completed operation.</p>
    {isTenantId(tenant)?<AiUsageView client:load tenantId={tenant}/>:<p role="alert">No access to this server.</p>}
  </main>
</ShellLayout>
