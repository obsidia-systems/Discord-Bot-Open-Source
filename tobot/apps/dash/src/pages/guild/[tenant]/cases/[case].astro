---
import AppHeader from "../../../../components/AppHeader.astro";
import { CaseDetailView } from "../../../../components/CaseDetailView";
import ShellLayout from "../../../../layouts/ShellLayout.astro";
import { SESSION_COOKIE } from "../../../../lib/session";
import { isTenantId } from "../../../../lib/shell-state";

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session?.value) return Astro.redirect("/auth/login");

const tenant = Astro.params.tenant ?? "";
const caseId = Astro.params.case ?? "";
const known = isTenantId(tenant) && isTenantId(caseId);
---

<ShellLayout title="Case">
  <AppHeader />
  <main id="content" class="mx-auto w-full max-w-2xl px-6 pb-16">
    {
      known ? (
        <CaseDetailView client:load tenantId={tenant} caseId={caseId} />
      ) : (
        <>
          <h1 class="text-2xl font-semibold tracking-tight">No access</h1>
          <p class="mt-3 leading-relaxed text-zinc-700" role="alert">
            You do not have access to this server.
          </p>
        </>
      )
    }
  </main>
</ShellLayout>
