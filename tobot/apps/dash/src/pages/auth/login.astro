---
import ShellLayout from "../../layouts/ShellLayout.astro";
---

<ShellLayout title="Sign in">
  <main id="content" class="mx-auto w-full max-w-2xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
    <p class="mt-3 leading-relaxed text-zinc-700">
      Continue to Discord to sign in to Tobot.
    </p>
    <a
      class="mt-8 inline-flex border border-zinc-950 bg-zinc-950 px-4 py-2 text-white hover:bg-white hover:text-zinc-950"
      href="/auth/discord/start">Sign in with Discord</a
    >
  </main>
</ShellLayout>
