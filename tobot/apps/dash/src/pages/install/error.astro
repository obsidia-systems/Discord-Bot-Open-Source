---
import ShellLayout from "../../layouts/ShellLayout.astro";
import { browserErrorMessage } from "../../lib/shell-state";

const message = browserErrorMessage(Astro.url.searchParams.get("reason"));
---

<ShellLayout title="Install failed">
  <main id="content" class="mx-auto w-full max-w-2xl px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">Install failed</h1>
    <p class="mt-3 leading-relaxed text-zinc-700" role="alert">{message}</p>
    <a
      class="mt-6 inline-block underline decoration-zinc-400 underline-offset-4 hover:decoration-zinc-950"
      href="/">Back to servers</a
    >
  </main>
</ShellLayout>
