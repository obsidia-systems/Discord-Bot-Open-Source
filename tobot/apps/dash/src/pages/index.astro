---
import AppHeader from "../components/AppHeader.astro";
import { GuildPicker } from "../components/GuildPicker";
import ShellLayout from "../layouts/ShellLayout.astro";
import { SESSION_COOKIE } from "../lib/session";

const session = Astro.cookies.get(SESSION_COOKIE);
if (!session?.value) return Astro.redirect("/auth/login");
---

<ShellLayout title="Servers">
  <AppHeader />
  <main id="content" class="mx-auto w-full max-w-2xl px-6 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight">Your servers</h1>
    <p class="mt-3 leading-relaxed text-zinc-700">
      Selecting a server does not grant access. Installation state comes from
      the server.
    </p>
    <GuildPicker client:load />
  </main>
</ShellLayout>
