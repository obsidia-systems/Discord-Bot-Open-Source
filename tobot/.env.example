TOBOT_PUBLIC_APP_ORIGIN=https://dash.tobot.test
TOBOT_DISCORD_OAUTH_REDIRECT_URI=https://dash.tobot.test/auth/discord/callback
TOBOT_DISCORD_INSTALL_REDIRECT_URI=https://dash.tobot.test/install/discord/callback
TOBOT_CONTROL_BIND=0.0.0.0:8080
TOBOT_DATABASE_URL=postgres://tobot:development-only@postgres:5432/tobot
TOBOT_LEDGER_DB_PASSWORD=replace-with-random-hex
TOBOT_LEDGER_SERVICE_TOKEN=replace-with-32-random-bytes
TOBOT_LEDGER_RECEIPT_KEY=replace-with-32-random-bytes
TOBOT_PROVIDER_EDGE_DB_PASSWORD=replace-with-random-hex
TOBOT_BILLING_DB_PASSWORD=replace-with-random-hex
TOBOT_PROVIDER_TO_BILLING_TOKEN=replace-with-32-random-bytes
TOBOT_BILLING_COMMAND_TOKEN=replace-with-32-random-bytes
TOBOT_BILLING_TO_CONTROL_TOKEN=replace-with-32-random-bytes
TOBOT_CATALOG_ADMIN_TOKEN=replace-with-32-random-bytes
TOBOT_AI_DB_PASSWORD=replace-with-random-hex
TOBOT_AI_SERVICE_TOKEN=replace-with-32-random-bytes
TOBOT_AI_RECEIPT_KEY=replace-with-32-random-bytes
# Cifra las claves de proveedor guardadas desde el admin. 32 caracteres o más. Solo la monta tobot-ai.
TOBOT_AI_SECRET_KEY=
TOBOT_ADMIN_OPERATOR_TOKEN=replace-with-separate-32-random-bytes
TOBOT_STRIPE_TEST_API_KEY=replace-with-restricted-rk_test-key
TOBOT_STRIPE_TEST_WEBHOOK_SECRET=replace-with-whsec-test-secret
# Con perfil billing-dev, usar el whsec de `stripe listen --print-secret` para esta cuenta de prueba.
TOBOT_STRIPE_TEST_ACCOUNT_SCOPE=replace-with-test-account-identifier
TOBOT_REDIS_URL=redis://redis:6379/0
TOBOT_DISCORD_APPLICATION_ID=replace-me
TOBOT_DISCORD_CLIENT_ID=replace-me
TOBOT_DISCORD_CLIENT_SECRET=replace-me
TOBOT_DISCORD_BOT_TOKEN=replace-me
TOBOT_GUILD_MEMBERS_INTENT_CONFIRMED=false
TOBOT_DELIVERY_URL=http://delivery:8081
TOBOT_INTERNAL_SERVICE_TOKEN=replace-with-32-random-bytes
TOBOT_VAULT_DEV_ROOT_TOKEN=development-only-vault-token
TOBOT_VAULT_TOKEN=development-only-vault-token
TOBOT_VAULT_ADDR=http://vault:8200
TOBOT_VAULT_TRANSIT_KEY=tobot-oauth
